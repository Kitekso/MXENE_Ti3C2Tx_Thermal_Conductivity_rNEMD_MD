units           metal
dimension       3
boundary        p p p
atom_style      charge

read_data       Ti3C2_nanosheet_20s.lmp

pair_style      meam        #pole meam
pair_coeff      * * library.meam Ti C TiC.meam Ti C

thermo          100     #relaksacja
thermo_style    custom step pe ke etotal temp press
thermo_modify   flush yes

min_style       cg
minimize        1.0e-6 1.0e-8 1000 10000

reset_timestep  0
timestep        0.001

velocity        all create 300.0 12345 dist gaussian

fix             termostat all nvt temp 300.0 300.0 0.1
run             100000
unfix           termostat       #faza NVT

thermo_style    custom step pe ke etotal temp press pxx pyy lx ly
thermo_modify   flush yes

fix             barostat all npt temp 300.0 300.0 0.1 x 0.0 0.0 1.0 y 0.0 0.0 1.0
run             100000
unfix           barostat         #faza NPT

fix             izolacja all nve

compute         plastry all chunk/atom bin/1d x lower 0.05 units reduced
fix             profil_T all ave/chunk 10 1000 10000 plastry temp file profil_20nms_2.txt

fix             heat all thermal/conductivity 200 x 20

compute         energia_kinetyczna all ke/atom
dump            film_ovito all custom 100 cieplo_wizualizacja_1.lammpstrj id type x y z c_energia_kinetyczna

thermo          200
thermo_style    custom step temp press f_heat xlo xhi ylo yhi
thermo_modify   flush yes

run             600000